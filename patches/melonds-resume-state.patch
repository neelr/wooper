@@ -103,6 +104,14 @@ void DMA::DoSavestate(Savestate* file)
     file->Bool32(&InProgress);
     file->Bool32(&IsGXFIFODMA);
     file->Var32(&MRAMBurstCount);
+
+    // Timing table pointers are process-local and absent from legacy states.
+    // Restart the burst so its next unit selects a valid table for this bus.
+    if (!file->Saving)
+    {
+        MRAMBurstCount = 0;
+        MRAMBurstTable = DMATiming::MRAMDummy;
+    }
 }
 
